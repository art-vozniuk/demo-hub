{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {"type": "row", "title": "Host overview (VDS)", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100},
    {
      "type": "stat",
      "title": "CPU utilization",
      "description": "Share of CPU time not idle, across all cores.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "targets": [{"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Memory utilization",
      "description": "1 - MemAvailable/MemTotal.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Disk used (/)",
      "description": "Root filesystem usage.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"})", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "targets": [{"expr": "node_time_seconds - node_boot_time_seconds", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0}, "overrides": []}
    },

    {"type": "row", "title": "CPU & load", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 101},
    {
      "type": "timeseries",
      "title": "CPU by mode",
      "description": "Per-mode share of total CPU. Sustained high iowait = disk-bound; high system = syscall/network heavy.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "targets": [
        {"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))", "legendFormat": "total", "refId": "A"},
        {"expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"user\"}[1m]))", "legendFormat": "user", "refId": "B"},
        {"expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"system\"}[1m]))", "legendFormat": "system", "refId": "C"},
        {"expr": "100 * avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[1m]))", "legendFormat": "iowait", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Load average vs cores",
      "description": "Load above the core count (dashed sense) means tasks are waiting for CPU — saturation.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "targets": [
        {"expr": "node_load1", "legendFormat": "1m", "refId": "A"},
        {"expr": "node_load5", "legendFormat": "5m", "refId": "B"},
        {"expr": "node_load15", "legendFormat": "15m", "refId": "C"},
        {"expr": "count(node_cpu_seconds_total{mode=\"idle\"})", "legendFormat": "cores", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 0}}, "overrides": [{"matcher": {"id": "byName", "options": "cores"}, "properties": [{"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]}
    },

    {"type": "row", "title": "Memory", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "id": 102},
    {
      "type": "timeseries",
      "title": "Memory",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 7,
      "targets": [
        {"expr": "node_memory_MemTotal_bytes", "legendFormat": "total", "refId": "A"},
        {"expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "used", "refId": "B"},
        {"expr": "node_memory_MemAvailable_bytes", "legendFormat": "available", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Swap (pressure signal)",
      "description": "Any sustained swap-in/out on a small VDS means memory pressure — investigate before OOM.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 8,
      "targets": [
        {"expr": "node_memory_SwapTotal_bytes", "legendFormat": "swap total", "refId": "A"},
        {"expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes", "legendFormat": "swap used", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },

    {"type": "row", "title": "Disk & network", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "id": 103},
    {
      "type": "timeseries",
      "title": "Disk usage by mount",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
      "id": 9,
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"})", "legendFormat": "{{mountpoint}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "fillOpacity": 10}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Disk I/O",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24},
      "id": 10,
      "targets": [
        {"expr": "rate(node_disk_read_bytes_total[1m])", "legendFormat": "{{device}} read", "refId": "A"},
        {"expr": "rate(node_disk_written_bytes_total[1m])", "legendFormat": "{{device}} write", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Network I/O",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24},
      "id": 11,
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br.*\"}[1m])", "legendFormat": "{{device}} rx", "refId": "A"},
        {"expr": "rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|br.*\"}[1m])", "legendFormat": "{{device}} tx", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["platform", "host"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Host / VDS System",
  "uid": "host-system",
  "version": 1
}
