{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {"type": "row", "title": "API (core)", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100},
    {
      "type": "stat",
      "title": "Requests (selected range)",
      "description": "Total core HTTP requests in the dashboard time range. With one manual test run you still see real numbers here — nothing averages away.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "targets": [{"expr": "sum(increase(demo_hub_http_request_duration_seconds_count[$__range]))", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0"}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "5xx (selected range)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "targets": [{"expr": "sum(increase(demo_hub_http_request_duration_seconds_count{status=\"5xx\"}[$__range]))", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Requests by route",
      "description": "increase() over the auto interval — a single request shows as a visible bar, not a 0.01 rps blip.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 1},
      "id": 3,
      "targets": [{"expr": "sum by (route) (increase(demo_hub_http_request_duration_seconds_count[1m]))", "legendFormat": "{{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "HTTP latency by route (avg per request / p95)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 1},
      "id": 4,
      "targets": [
        {"expr": "sum by (route) (increase(demo_hub_http_request_duration_seconds_sum[1m])) / sum by (route) (increase(demo_hub_http_request_duration_seconds_count[1m]))", "legendFormat": "avg {{route}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(demo_hub_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p95 (all routes)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },

    {"type": "row", "title": "Pipelines (all applications)", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 8}, "id": 101},
    {
      "type": "stat",
      "title": "Completed (range)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 9},
      "id": 5,
      "targets": [{"expr": "sum(increase(demo_hub_pipeline_e2e_seconds_count{status=\"COMPLETED\"}[$__range]))", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0"}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Failed (range)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 9},
      "id": 6,
      "targets": [{"expr": "sum(increase(demo_hub_pipeline_e2e_seconds_count{status=\"FAILED\"}[$__range]))", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "End-to-end latency per pipeline (avg per run)",
      "description": "User-perceived: queue POST → terminal status in DB. With one run in the interval this IS that run's duration.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 9},
      "id": 7,
      "targets": [{"expr": "sum by (pipeline_name) (increase(demo_hub_pipeline_e2e_seconds_sum[1m])) / sum by (pipeline_name) (increase(demo_hub_pipeline_e2e_seconds_count[1m]))", "legendFormat": "{{pipeline_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "points", "pointSize": 8}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Queue wait (avg per run)",
      "description": "Time jobs sat in RabbitMQ before a worker picked them up.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 9},
      "id": 8,
      "targets": [{"expr": "sum by (pipeline_name) (increase(demo_hub_queue_wait_seconds_sum[1m])) / sum by (pipeline_name) (increase(demo_hub_queue_wait_seconds_count[1m]))", "legendFormat": "{{pipeline_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "points", "pointSize": 8}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Pipeline failures by error type",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16},
      "id": 9,
      "targets": [{"expr": "sum by (pipeline_name, error_type) (increase(demo_hub_pipeline_failures_total[1m]))", "legendFormat": "{{pipeline_name}} / {{error_type}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Runs per pipeline",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16},
      "id": 10,
      "targets": [{"expr": "sum by (pipeline_name) (increase(demo_hub_pipeline_duration_seconds_count[1m]))", "legendFormat": "{{pipeline_name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60, "stacking": {"mode": "normal"}}}, "overrides": []}
    },

    {"type": "row", "title": "Dependencies (Postgres / RabbitMQ / scrape)", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}, "id": 102},
    {
      "type": "timeseries",
      "title": "DB query latency by operation (avg / p95)",
      "description": "Degradation in Supabase Postgres shows up here first.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 23},
      "id": 11,
      "targets": [
        {"expr": "sum by (operation) (increase(demo_hub_db_query_duration_seconds_sum[1m])) / sum by (operation) (increase(demo_hub_db_query_duration_seconds_count[1m]))", "legendFormat": "avg {{operation}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(demo_hub_db_query_duration_seconds_bucket[1m])))", "legendFormat": "p95 (all)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "DB errors",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 5, "x": 8, "y": 23},
      "id": 12,
      "targets": [{"expr": "sum by (operation) (increase(demo_hub_db_errors_total[1m]))", "legendFormat": "{{operation}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ publishes (errors highlighted)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 5, "x": 13, "y": 23},
      "id": 13,
      "targets": [
        {"expr": "sum by (routing_key, status) (increase(demo_hub_rabbitmq_publish_total[1m]))", "legendFormat": "{{routing_key}} / {{status}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".*error.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]}
    },
    {
      "type": "timeseries",
      "title": "Scrape targets up",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 23},
      "id": 14,
      "targets": [{"expr": "up", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 20}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "DB pool saturation (in use / capacity)",
      "description": "Connection-pool utilization per process. Climbing toward 1.0 = workers contending for connections; at 1.0 new queries block up to pool_timeout, then error. Direct saturation signal for our own pool (Supabase's server-side pooler is separate — see their dashboard).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 30},
      "id": 15,
      "targets": [{"expr": "sum by (job) (demo_hub_db_pool_connections{state=\"checked_out\"}) / sum by (job) (demo_hub_db_pool_capacity)", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 20}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "DB pool connections",
      "description": "Raw pool counters per process: in-use vs idle vs the capacity ceiling (pool_size + max_overflow).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 30},
      "id": 16,
      "targets": [
        {"expr": "demo_hub_db_pool_connections{state=\"checked_out\"}", "legendFormat": "{{job}} in use", "refId": "A"},
        {"expr": "demo_hub_db_pool_connections{state=\"idle\"}", "legendFormat": "{{job}} idle", "refId": "B"},
        {"expr": "demo_hub_db_pool_capacity", "legendFormat": "{{job}} capacity", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    }
  ],
