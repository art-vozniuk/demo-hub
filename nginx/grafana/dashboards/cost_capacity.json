{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "id": 99,
      "options": {"mode": "markdown", "content": "**Estimated** GPU cost, derived from the timings each Modal container returns with its response: work time + cold start + scaledown tail per container session, multiplied by published Modal rates (services/common/constants.py `GPU_HOURLY_USD`). Works in dev and prod with zero Modal-side setup. The *real* numbers live in Modal's billing dashboard and in the **Modal System** dashboard (modal.container.running × rate) once the OTel integration is enabled."}
    },
    {
      "type": "stat",
      "title": "Est. cost (selected range)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 3},
      "id": 1,
      "targets": [{"expr": "sum(increase(demo_hub_estimated_gpu_cost_usd_total[$__range]))", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 3, "noValue": "$0"}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Est. GPU time (range)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 3},
      "id": 2,
      "targets": [{"expr": "sum(increase(demo_hub_estimated_gpu_seconds_total[$__range]))", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "0"}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Cold-start share of GPU time (range)",
      "description": "Money spent warming containers instead of doing work.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 3},
      "id": 3,
      "targets": [{"expr": "sum(increase(demo_hub_inference_cold_start_duration_seconds_sum{phase!=\"snapshot_load\"}[$__range])) / clamp_min(sum(increase(demo_hub_estimated_gpu_seconds_total[$__range])), 0.001)", "refId": "A", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "noValue": "no runs", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.6}]}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Est. cost over time by application",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 3},
      "id": 4,
      "targets": [{"expr": "sum by (config, gpu) (increase(demo_hub_estimated_gpu_cost_usd_total[$__rate_interval]))", "legendFormat": "{{config}} ({{gpu}})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "custom": {"drawStyle": "bars", "fillOpacity": 60, "stacking": {"mode": "normal"}}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Est. GPU seconds by application",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 9},
      "id": 5,
      "targets": [{"expr": "sum by (config, gpu) (increase(demo_hub_estimated_gpu_seconds_total[$__rate_interval]))", "legendFormat": "{{config}} ({{gpu}})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "bars", "fillOpacity": 60, "stacking": {"mode": "normal"}}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Projected $/day (rate-based; needs steady traffic)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 9},
      "id": 6,
      "targets": [{"expr": "sum by (config) (rate(demo_hub_estimated_gpu_cost_usd_total[1h])) * 86400", "legendFormat": "{{config}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Cold starts (each costs a spin-up + scaledown tail)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16},
      "id": 7,
      "targets": [{"expr": "sum by (config) (increase(demo_hub_inference_requests_total{cold=\"true\"}[$__rate_interval]))", "legendFormat": "{{config}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Requests per container session (warm reuse)",
      "description": "Total runs ÷ cold starts — how many requests each container serves before scaling down. Higher = better amortization.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16},
      "id": 8,
      "targets": [{"expr": "sum by (config) (increase(demo_hub_inference_requests_total[$__rate_interval])) / clamp_min(sum by (config) (increase(demo_hub_inference_requests_total{cold=\"true\"}[$__rate_interval])), 1)", "legendFormat": "{{config}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["cost"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Cost / Capacity (estimated)",
  "uid": "cost-capacity",
  "version": 1
}
