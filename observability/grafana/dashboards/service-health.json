{
  "title": "Service Health (Core API)",
  "uid": "service-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["core", "api"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS by endpoint",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (handler) (rate(http_requests_total{job=\"core\"}[1m]))",
        "legendFormat": "{{handler}}"
      }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p95 by endpoint",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"core\"}[5m])))",
        "legendFormat": "p95 {{handler}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (handler) (rate(http_requests_total{job=\"core\",status=~\"5..\"}[1m]))",
        "legendFormat": "{{handler}}"
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rate limited (429)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum (rate(http_requests_total{job=\"core\",status=\"429\"}[1m]))"
      }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "In-flight requests",
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(http_requests_in_progress{job=\"core\"})" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "S3 ops",
      "gridPos": { "x": 6, "y": 14, "w": 18, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (op, status) (rate(s3_operations_total[1m]))",
        "legendFormat": "{{op}} / {{status}}"
      }]
    }
  ]
}
