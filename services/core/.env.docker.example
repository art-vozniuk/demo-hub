# Generated by scripts/setup-local-env.sh from services/core/.env.
# Key differences from .env: service hostnames instead of localhost.

DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres
ENV=development
# SENTRY_DSN=

# Both ports needed: 8080 for nginx, 5173 for direct web dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Docker service names — do NOT use localhost here
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379

MODELS_BASE_URL=https://github.com/art-vozniuk/demo-hub/releases/download/large-assets
