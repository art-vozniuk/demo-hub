# Generated by scripts/setup-local-env.sh from services/web/.env.local.
# Key differences from .env.local: URLs point to localhost:8080 (nginx).

VITE_CORE_API_URL=http://localhost:8080/api/v1

VITE_S3_ACCESS_KEY_ID=
VITE_S3_ACCESS_KEY_SECRET=
VITE_S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
VITE_S3_PUBLIC_BUCKETS_ENDPOINT=https://<project>.supabase.co/storage/v1/object/public
VITE_S3_REGION=eu-central-1

VITE_RENDERER_URL=/renderer/Sandbox.html
RENDERER_DATA_URL=https://github.com/art-vozniuk/demo-hub/releases/download/renderer-latest/Sandbox.data

VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key. Leave empty to disable in dev.

VITE_BUILD_TAG=local
