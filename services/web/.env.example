VITE_CORE_API_URL=
VITE_RENDERER_URL=/renderer/Sandbox.html

# Sentry — same DSN as backend services (or a separate web project DSN).
# Leave empty to disable Sentry (no-op init).
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
# Optional release tag — wired automatically in CI from the commit SHA.
VITE_BUILD_TAG=local

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# S3 (browser-side direct uploads)
VITE_S3_REGION=
VITE_S3_ENDPOINT=
VITE_S3_PUBLIC_BUCKETS_ENDPOINT=
VITE_S3_ACCESS_KEY_ID=
VITE_S3_ACCESS_KEY_SECRET=

# Cloudflare Turnstile site key (frontend). Leave empty to disable.

# Analytics
VITE_GA_MEASUREMENT_ID=
