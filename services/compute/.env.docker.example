# Generated by scripts/setup-local-env.sh from services/compute/.env.
# Key difference from .env: RABBITMQ_URL uses docker service name.

S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
S3_PUBLIC_BUCKETS_ENDPOINT=https://<project>.supabase.co/storage/v1/object/public
S3_REGION=eu-central-1

ENV=development
# SENTRY_DSN=

# Docker service name — do NOT use localhost here
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_PREFETCH=10

MODELS_BASE_URL=https://github.com/art-vozniuk/demo-hub/releases/download/large-assets
